{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/rarevariantburden/master/assets/schema_chr_vcf_index.json",
    "title": "nf-core/rarevariantburden pipeline - chromosome/VCF/index file list schema",
    "description": "Schema for file lists that provide a chromosome, a VCF file, and its index (used by params.caseNormalizedVCFFileList and params.caseAnnotatedVCFFileList)",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "chr": {
                "type": [
                    "string",
                    "integer"
                ],
                "errorMessage": "Chromosome must be provided"
            },
            "vcf": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.vcf\\.gz$",
                "errorMessage": "VCF file must exist and end in .vcf.gz"
            },
            "index": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(tbi|csi)$",
                "errorMessage": "Index file must exist and end in .tbi or .csi"
            }
        },
        "required": [
            "chr",
            "vcf",
            "index"
        ]
    }
}
