{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/rarevariantburden/master/assets/schema_chr_vcf.json",
    "title": "nf-core/rarevariantburden pipeline - chromosome/VCF file list schema",
    "description": "Schema for file lists that provide a chromosome and its VCF file (used by params.caseVCFFileList)",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "chr": {
                "type": ["string", "integer"],
                "errorMessage": "Chromosome must be provided"
            },
            "vcf": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.vcf\\.gz$",
                "errorMessage": "VCF file must exist and end in .vcf.gz"
            }
        },
        "required": ["chr", "vcf"]
    }
}
